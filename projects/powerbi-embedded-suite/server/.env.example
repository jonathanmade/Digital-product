# ── Microsoft Entra ID app registration (service principal) ──────────────
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Prefer a certificate or Key Vault reference in production. Never commit.
AZURE_CLIENT_SECRET=replace-me

# ── Power BI content ─────────────────────────────────────────────────────
PBI_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
PBI_REPORT_ID=00000000-0000-0000-0000-000000000000
# Name of the RLS role defined in the semantic model (see powerbi/rls-role.dax)
PBI_RLS_ROLE=Pharmacy

# ── Web server ───────────────────────────────────────────────────────────
PORT=3000
# Origin of the pharmacy portal allowed to call this API
ALLOWED_ORIGIN=http://localhost:3000
